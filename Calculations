import java.util.Scanner;

public class Calculations {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        String command = scanner.nextLine();

        int first = Integer.parseInt(scanner.nextLine());
        int second = Integer.parseInt(scanner.nextLine());

        int result = 0;

        switch (command) {
            case "add":
                result = addNumber(first, second);
                break;

            case "multiply":
                result = multiplyNumbers(first, second);
                break;

            case "subtract":
                result = subtractNumbers(first, second);
                break;

            case "divide":
                result = divideNumbers(first, second);
                break;
        }

        System.out.println(result);
    }

    private static int addNumber(int first, int second) {
        return(first + second);
    }

    private static int multiplyNumbers(int first, int second) {
        return(first * second);
    }

    private static int subtractNumbers(int first, int second) {
        return(first - second);
    }

    private static int divideNumbers(int first, int second) {
        return(first / second);
    }

}
